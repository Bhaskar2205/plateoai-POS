# Dependencies
node_modules/

# Environment - never commit real secrets. .env.example is the template.
.env
.env.local
.env.*.local
.env.*
!.env.example

# Database dumps and backups - they contain real account data.
*.sql
*.sql.gz
*.dump
backups/

# Keys and certificates (e.g. a managed MySQL CA downloaded for DB_SSL_CA).
*.pem
*.key
*.p12
*.pfx
*.crt

# Hosting CLI state
.vercel/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test + coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Uploaded dish photos (restaurant data, served from a volume in production)
backend/uploads/

# Local Claude Code settings (per-machine permissions, not shared)
.claude/settings.local.json
