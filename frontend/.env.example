# ---------------------------------------------------------------------------
# Plateo QR web app environment
#   PowerShell:  Copy-Item .env.example .env.local
#
# NEXT_PUBLIC_* values are compiled into the browser bundle at BUILD time:
# set them before `npm run build`, and redeploy after changing them.
# ---------------------------------------------------------------------------

# Base URL of the Plateo backend API. Exposed to the browser - no secrets.
# Production: https://api.plateoai.in
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this app, used for canonical/Open Graph URLs on public menus.
# Production: https://app.plateoai.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: server-side API URL for server-rendered pages (e.g. an internal hostname).
# Falls back to NEXT_PUBLIC_API_URL when unset.
# PLATEO_API_URL=https://api.plateoai.in

# Server-only (never NEXT_PUBLIC_). Must equal the backend's INTERNAL_PROXY_SECRET.
# Lets server-rendered public menus forward each diner's IP, so diners are rate
# limited individually instead of all sharing this server's IP.
# INTERNAL_PROXY_SECRET=
