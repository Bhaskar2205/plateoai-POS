# Base URL of the Plateo backend API.
# Exposed to the browser, so it must contain no secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this frontend, used for canonical/Open Graph URLs on public menus.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: server-side API URL for server-rendered pages (e.g. an internal hostname).
# Falls back to NEXT_PUBLIC_API_URL when unset.
# PLATEO_API_URL=http://localhost:4000
