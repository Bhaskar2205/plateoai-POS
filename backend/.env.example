# ---------------------------------------------------------------------------
# Plateo backend environment
# Copy to .env and fill in real values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
#
# Production values (api.plateoai.in) are shown in the comments; the defaults
# below are for local development.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# Production: https://app.plateoai.in   (exact origin, no trailing slash, no wildcard)
CORS_ORIGINS=http://localhost:3000

# Public origin of the QR web app (no trailing slash or path). Table QR codes
# encode menu URLs on this origin, so it must be the app, NOT the marketing site
# (https://plateoai.in). Must be https in production.
# Local development: http://localhost:3000
PUBLIC_WEB_URL=https://app.plateoai.in

# Serve Swagger UI at /api/docs. Defaults to true outside production.
# Production: false
SWAGGER_ENABLED=true

# --- Proxies and rate limiting ----------------------------------------------
# Number of reverse proxies / load balancers in front of the API, so rate limits
# apply to the real client IP. Leave empty when clients connect directly, or
# anyone could spoof their IP via X-Forwarded-For. Never "true" in production.
# Production behind one platform load balancer: 1
TRUST_PROXY=

# Shared secret the Next.js server sends when it fetches public menus for diners,
# so each diner is rate limited by their own IP instead of the frontend server's.
# Set the SAME value on the frontend (server-only variable). At least 32 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_PROXY_SECRET=

# --- MySQL 8 ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=plateo

# Keep false. Schema changes go through `npm run migration:run`.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# TLS for managed MySQL. Required in production unless DB_HOST is localhost or a
# private platform network host (*.railway.internal - Railway's private network
# carries no TLS and never leaves Railway).
# DB_SSL_CA is the provider's CA certificate (PEM). Newlines may be written as \n
# so it fits on one line. Certificates are always verified;
# DB_SSL_REJECT_UNAUTHORIZED=false is for local experiments only and is refused
# in production.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ------------------------------------------------------------------
# Generate a fresh 64-char secret, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# --- Login rate limiting ---------------------------------------------------
# 5 attempts per 60 seconds per IP on /auth/login and /auth/register.
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5
