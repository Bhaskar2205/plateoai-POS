# ---------------------------------------------------------------------------
# Plateo backend environment
# Copy to .env and fill in real values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
#
# Production values (api.plateoai.in) are shown in the comments; the defaults
# below are for local development.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# Production: https://app.plateoai.in   (exact origin, no trailing slash, no wildcard)
CORS_ORIGINS=http://localhost:3000

# Public origin of the QR web app (no trailing slash or path). Table QR codes
# encode menu URLs on this origin, so it must be the app, NOT the marketing site
# (https://plateoai.in). Must be https in production.
# Local development: http://localhost:3000
PUBLIC_WEB_URL=https://app.plateoai.in

# Serve Swagger UI at /api/docs. Defaults to true outside production.
# Production: false
SWAGGER_ENABLED=true

# --- Proxies and rate limiting ----------------------------------------------
# Number of reverse proxies / load balancers in front of the API, so rate limits
# apply to the real client IP. Leave empty when clients connect directly, or
# anyone could spoof their IP via X-Forwarded-For. Never "true" in production.
# Production behind one platform load balancer: 1
TRUST_PROXY=

# Shared secret the Next.js server sends when it fetches public menus for diners,
# so each diner is rate limited by their own IP instead of the frontend server's.
# Set the SAME value on the frontend (server-only variable). At least 32 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_PROXY_SECRET=

# --- MySQL 8 ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=plateo

# Keep false. Schema changes go through `npm run migration:run`.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# TLS for managed MySQL. Required in production unless DB_HOST is localhost or a
# private platform network host (*.railway.internal - Railway's private network
# carries no TLS and never leaves Railway).
# DB_SSL_CA is the provider's CA certificate (PEM). Newlines may be written as \n
# so it fits on one line. Certificates are always verified;
# DB_SSL_REJECT_UNAUTHORIZED=false is for local experiments only and is refused
# in production.
# Connections the API keeps open to MySQL. The driver default is 10, which
# queues a rush of QR scans behind each other - one menu read is several queries.
# Keep it below the server's max_connections divided by the number of instances.
DB_POOL_SIZE=20

DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ------------------------------------------------------------------
# Generate a fresh 64-char secret, e.g. in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# --- Login rate limiting ---------------------------------------------------
# 5 attempts per 60 seconds per IP on /auth/login and /auth/register.
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=5

# --- Public menu rate limiting ----------------------------------------------
# Much higher than the general limit of 120 a minute, and it has to be: every
# diner on a restaurant's wifi reaches the API from the same NAT address, so 150
# people scanning the QR code at the start of service look like one client making
# 150 requests in a second. At 120 the last thirty were shown an error page.
PUBLIC_MENU_THROTTLE_TTL=60
PUBLIC_MENU_THROTTLE_LIMIT=600

# --- Dish photos -------------------------------------------------------------
# Photos are uploaded through the API, re-encoded as WebP and stored on disk.
# Locally a relative path is fine. In production this MUST be an absolute path on
# a mounted volume (on Railway: add a volume and mount it at /data), or every
# photo is lost on the next deploy.
UPLOADS_DIR=/data/uploads
# Public origin of this API. Photo URLs are stored on dishes using it, so changing
# it later does not rewrite URLs already saved.
PUBLIC_API_URL=https://api.plateoai.in
# Largest upload accepted, in bytes, before re-encoding. Default 8 MB.
UPLOAD_MAX_BYTES=8388608

# --- Dish photos in Cloudflare Images ----------------------------------------
# Optional. Without all three, photos are written to UPLOADS_DIR exactly as
# before, which is what the test suite and a fresh clone do.
#
# Why bother: photos stop living on the API's own volume, so a deploy or a second
# instance cannot lose or hide them, and Cloudflare derives the menu-grid size
# from the uploaded photo - a 64-dish menu costs a few hundred KB to scroll
# instead of several MB.
#
# Set up, once:
#   1. Cloudflare dashboard > Images, subscribe (storage is on the paid plan).
#   2. My Profile > API Tokens > Create Token, custom token, permission
#      Account > Cloudflare Images > Edit. Leave the Start Date EMPTY and set no
#      expiry - a token dated in the future fails with a bare 401, and one that
#      expires breaks uploads on a day nobody remembers.
#   3. Images > Variants, create two: thumb (400px, scale down) and full (1600px).
#   4. node scripts/cloudflare-account-hash.mjs prints the account hash.
#
# The account id is not a secret - it is in every API URL. The token is.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Only if you named the variants something else in the dashboard.
CLOUDFLARE_IMAGES_THUMB_VARIANT=thumb
CLOUDFLARE_IMAGES_FULL_VARIANT=full


# --- Idempotency -----------------------------------------------------------
# How long a used Idempotency-Key is kept, so a late retry replays the original
# response instead of running the operation again. Sweeping is not automatic:
# call IdempotencyService.purgeOlderThan from a scheduled job.
IDEMPOTENCY_RETENTION_DAYS=7

# --- Payments ---------------------------------------------------------------
# Razorpay. All three are required together: a key without a webhook secret can
# take money it cannot then confirm. Without all three the provider reports
# itself NOT_CONFIGURED and refuses every call - it never falls back to a mock.
# NEVER commit real values, and never expose the secrets to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# How long an unpaid payment attempt stays open before reconciliation treats it
# as abandoned.
PAYMENT_INTENT_EXPIRY_MINUTES=30
